<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/light_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Audio Icon Badge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/primary_light"
            app:strokeWidth="0dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/imgAudioType"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@color/primary"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Information Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRecordingDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oct 18, 2026 • 06:15 PM"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"/>

            <TextView
                android:id="@+id/txtRecordingMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:45 • 340 KB"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/txtRecordingSession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session: sos_17292..."
                android:textSize="11sp"
                android:textColor="@color/medium_gray"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Play / Pause Action Button -->
        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_play"
            app:tint="@color/primary"
            android:contentDescription="Play Recording"
            android:padding="8dp"/>

        <!-- Delete Action Button -->
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="@color/error_red"
            android:contentDescription="Delete Recording"
            android:padding="8dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
