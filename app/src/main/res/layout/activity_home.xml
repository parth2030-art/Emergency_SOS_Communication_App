<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCFDFD">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#B8000F"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency SOS"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Location Status -->
    <TextView
        android:id="@+id/txtLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍 Location Enabled"
        android:textColor="#008000"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SOS Button -->
    <Button
        android:id="@+id/btnSOS"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:text="SOS"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold"
        android:backgroundTint="#D32F2F"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Instruction -->
    <Button
        android:id="@+id/btnStopSOS"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STOP SOS"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#D22F2F"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtInstruction"
        app:layout_constraintVertical_bias="0.568" />
    <TextView
        android:id="@+id/txtInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap the button in emergency situation"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnSOS"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Contacts Image Button -->
    <ImageButton
        android:id="@+id/btnContacts"
        android:layout_width="150dp"
        android:layout_height="70dp"
        android:src="@drawable/contacts"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:contentDescription="My Contacts"
        app:layout_constraintTop_toBottomOf="@id/txtInstruction"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp" />

    <!-- Call Image Button -->
    <ImageButton
        android:id="@+id/btnCall"
        android:layout_width="150dp"
        android:layout_height="70dp"
        android:src="@drawable/call"
        android:background="@android:color/transparent"
        android:contentDescription="My Contacts"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toBottomOf="@id/txtInstruction"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="25dp"/>

    <!-- SMS Image Button -->
    <ImageButton
        android:id="@+id/btnSMS"
        android:layout_width="150dp"
        android:layout_height="70dp"
        android:src="@drawable/sms"
        android:contentDescription="My Contacts"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toBottomOf="@id/btnContacts"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="15dp"/>

    <!-- Location Image Button -->
    <ImageButton
        android:id="@+id/btnLocation"
        android:layout_width="150dp"
        android:layout_height="70dp"
        android:src="@drawable/location"
        android:contentDescription="My Contacts"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toBottomOf="@id/btnCall"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="15dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>