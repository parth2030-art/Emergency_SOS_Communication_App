<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_emergency_gradient">

    <!-- Top Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY SOS"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Settings"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Location Status Pill -->
    <LinearLayout
        android:id="@+id/statusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_status_pill"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/ic_status_dot"
            app:tint="@color/success_green"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/txtLocationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location Enabled"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Circular SOS Button Container (for pulse effect) -->
    <FrameLayout
        android:id="@+id/sosButtonContainer"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:layout_constraintTop_toBottomOf="@id/statusContainer"
        app:layout_constraintBottom_toTopOf="@id/quickActionsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <!-- Outer Pulse Ring -->
        <View
            android:id="@+id/sosPulseRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_sos_pulse"
            android:alpha="0.2"/>

        <Button
            android:id="@+id/btnSOS"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:text="SOS"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold"
            android:background="@drawable/btn_sos_background"
            app:backgroundTint="@null"
            android:elevation="8dp"/>
    </FrameLayout>

    <TextView
        android:id="@+id/txtInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap the button in emergency situation"
        android:textColor="@color/light_gray"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/sosButtonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/quickActionsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUICK ACTIONS"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:alpha="0.7"
        app:layout_constraintBottom_toTopOf="@id/gridFlow"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="8dp"/>

    <!-- Grid Layout using ConstraintLayout Flow -->
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/gridFlow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:flow_maxElementsWrap="2"
        app:flow_wrapMode="aligned"
        app:flow_horizontalGap="12dp"
        app:flow_verticalGap="12dp"
        app:constraint_referenced_ids="btnContacts,btnCall,btnSMS,btnLocation"
        app:layout_constraintBottom_toTopOf="@id/btnStopSOS"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Features Cards -->
    <!-- Emergency Contacts Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnContacts"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/glass_white_overlay"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF"
        app:cardElevation="0dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_contacts"
                app:tint="@color/primary_light"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contacts"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Call Emergency Contact Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnCall"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/glass_white_overlay"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF"
        app:cardElevation="0dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_call"
                app:tint="@color/primary_light"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call Contact"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Send Test SMS Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnSMS"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/glass_white_overlay"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF"
        app:cardElevation="0dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_sms"
                app:tint="@color/primary_light"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send SMS"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Live Location Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnLocation"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/glass_white_overlay"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF"
        app:cardElevation="0dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_location"
                app:tint="@color/primary_light"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Location"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Stop SOS button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStopSOS"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="STOP SOS"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_status_dot"
        app:iconTint="@color/white"
        app:backgroundTint="@color/primary"
        app:cornerRadius="28dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="6dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>